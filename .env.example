# Copy file này thành .env rồi chỉnh giá trị cho máy mình (file .env KHÔNG commit).
# cp .env.example .env

# Base URL của Laravel API (kèm /api)
# Mặc định dùng "/api" và được proxy qua vite.config.ts
VITE_API_URL=/api

# Target của dev proxy (vite.config.ts) — trỏ tới Laravel
VITE_API_PROXY_TARGET=http://localhost:8000

# Khoá lưu token JWT trong localStorage
VITE_TOKEN_KEY=food-sg-admin-token
